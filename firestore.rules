rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ledger/{doc} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          "moto.seek4ever@gmail.com"
        ];
    }

    match /cafe_crm_leads/{leadId} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          "moto.seek4ever@gmail.com"
        ];
    }

    match /namamame_kakaku/{doc} {
      allow read, write: if request.auth != null &&
        request.auth.token.email in [
          "moto.seek4ever@gmail.com",
          "satoshi.ngnd@gmail.com",
          "yousukekamikubo.arabcoffee@gmail.com",
          "moto1110arab@gmail.com",
          "umfm233@gmail.com",
          "hiranotaeko8@gmail.com",
          "yoshixiaoyuan7@gmail.com",
          "ma10a4ri1ta8@gmail.com"
        ];
    }
  }
}
